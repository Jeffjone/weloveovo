# Development without credentials uses a local fixture catalog. Production requires DATABASE_URL.
# Set all four values for hosted catalog, curator authentication, and audio storage.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails of invited curator users; also add their IDs to curators.
CURATOR_EMAILS=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional Genius integration. Server only; never use a NEXT_PUBLIC_ prefix.
GENIUS_ACCESS_TOKEN=

# Optional server-only GitHub token with Actions write permission for this repository.
GITHUB_ACTIONS_TOKEN=
